# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
#
# Verified 2026-08-02 against `git grep process.env`: this is every variable the
# code actually reads. Anything not listed here is not wired to anything.

# ---------------------------------------------------------------------------
# OpenAI — Wrapped narrative, vision best-frame/subject, artist task copy.
# Optional: every FACT still resolves without it (stage, set, dwell, mint all
# come from coordinates and timestamps). Only prose degrades to fallbacks.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Current flagship default; override only after evaluating quality, latency, and cost.
OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1/responses

# ---------------------------------------------------------------------------
# JamBase — required only at bootstrap. The running app reads the cached grid,
# so it never needs this key. Server-side bootstrap only; never NEXT_PUBLIC_*.
# Base URL is api.data.jambase.com/v3 with Bearer auth — read
# docs/JAMBASE-IMPLEMENTATION.md before writing any request code.
# ---------------------------------------------------------------------------
JAMBASE_API_KEY=

# ---------------------------------------------------------------------------
# Convex — written by `npx convex dev` on first link. That command needs an
# interactive login from someone with access to the project's team.
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Optional for scripts/bootstrap-grid.ts — the offline grid file is still written
# when Convex is not configured, but nothing is persisted server-side without it.
# Note seed-demo.ts falls back to NEXT_PUBLIC_CONVEX_URL; bootstrap-grid.ts does not.
CONVEX_URL=
