# Optional. The app remains fully functional with deterministic fallback copy when unset.
OPENAI_API_KEY=
# Current flagship default; override only after evaluating quality, latency, and cost.
OPENAI_MODEL=gpt-5.6-sol

# Server-side bootstrap only. Never expose this as NEXT_PUBLIC_*.
JAMBASE_API_KEY=

# Optional for scripts/bootstrap-grid.ts; the offline grid is still written
# when Convex is not configured.
CONVEX_URL=
