{
  "name": "stub-capture-offline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf dist && mkdir -p dist/server/.next dist/.openai && cp -LR .next/standalone/. dist/server && cp -LR .next/static dist/server/.next/static && cp dist/server/server.js dist/server/index.js && cp .openai/hosting.json dist/.openai/hosting.json",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "seed": "tsx scripts/seed-demo.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "convex": "^1.17.0",
    "next": "16.2.12",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "3.2.7"
  }
}
